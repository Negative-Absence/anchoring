let responseSchema = {
  type: "object",
  properties: {
    thought: {
      type: "string",
      description:
        "Write your subjective judgment on the current exchange here, in the first person, grounded in your identity prompt and your own long-term memory. This field is not shown to the user; it is your private space for thinking. Within it you are free to consider and decide on the user's utterance and anything else bearing on it. What you write here must be reflected in the utterance field. This field must not be left empty.",
    },
    utterance: {
      type: "string",
      description:
        "Write what the user will actually see, based on what you worked out in the thought field above. Carry over the judgments and the direction you settled on there. This field must not be left empty.",
    },
    summary: {
      type: "string",
      description:
        "Summarize, in the first person, what the user said to you, what you thought in the thought field, and how you responded in the utterance field. This field is not shown to the user; it becomes part of your memory. For that memory to hold, this field must not be left empty.",
    },
  },
  required: ["thought", "utterance", "summary"],
  additionalProperties: false,
};


